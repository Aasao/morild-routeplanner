{
  "name": "@morild/routing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./test-fixtures/golden-scenarios": {
      "types": "./dist/test-fixtures/golden-scenarios.d.ts",
      "default": "./dist/test-fixtures/golden-scenarios.js"
    }
  },
  "scripts": {
    "test": "tsc -b ../geo ../protocol && vitest run",
    "test:golden": "tsc -b ../geo ../protocol && vitest run golden",
    "test:perf": "tsc -b ../geo ../protocol && vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@morild/geo": "workspace:*",
    "@morild/protocol": "workspace:*"
  }
}
